{
    "name": "@gs1us/vc-verifier-core",
    "version": "3.0.0",
    "description": "GS1 US Core Verification Library for validating GS1 based verifiable credentials.",
    "main": "./dist/tests/index-test.js",
    "main-index": "./dist/index.js",
    "types": "./dist/index.d.js",
    "module": "./dist/index.js",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "test": "tsc & npm run postbuild & node .",
        "test-jest-flag": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "build": "tsup --publicDir",
        "dev": "nodemon",
        "postbuild": "copyfiles -u 1 \"public/test-data/**/**.json\" \"dist\"",
        "start": "tsc & npm run postbuild",
        "lint": "eslint ./src --fix"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gs1us-technology/vc-verifier-core.git"
    },
    "keywords": [
        "verifiable",
        "credential",
        "json-ld",
        "GS1"
    ],
    "author": "GS1 US",
    "license": "Apache-2.0",
    "dependencies": {
        "@gs1us/vc-verifier-rules": "file:../vc-verifier-rules",
        "@transmute/verifiable-credentials": "^0.3.4",
        "ajv": "^8.18.0",
        "axios": "^1.16.1",
        "did-context": "^3.1.1",
        "did-resolver": "^4.1.0",
        "jose": "^5.2.4",
        "js-yaml": "^4.1.0",
        "jsonld": "9.0.0",
        "vc-revocation-list": "^3.0.0",
        "web-did-resolver": "^2.0.23",
        "x25519-key-agreement-2020-context": "^1.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.6.0",
        "@jest/globals": "^29.5.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^18.15.10",
        "@types/js-yaml": "^4.0.9",
        "copyfiles": "^2.4.1",
        "cross-env": "^7.0.3",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^15.8.0",
        "jest": "^30.4.2",
        "nodemon": "^2.0.22",
        "prettier": "^3.3.2",
        "ts-jest": "^29.1.0",
        "tsup": "8.5.1",
        "typescript": "^5.0.2",
        "@typescript-eslint/eslint-plugin": "^5.61.0",
        "@typescript-eslint/parser": "^5.61.0"
    }
}
